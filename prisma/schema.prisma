generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// All money is stored as integer cents. The AI never writes to these tables
// directly; only governance-checked server code and verified PayPal events do.

model Collective {
  id          String   @id @default(cuid())
  name        String
  purpose     String
  kind        String   // "SCHOLARSHIP_FUND" | "BOOSTER_CLUB" | "COMMUNITY_FUND" | "OTHER"
  currency    String   @default("USD")
  // How this collective's own PayPal Business account is connected.
  // "SANDBOX_DEMO" = the shared TrustPool sandbox account used for the demo.
  paypalMode  String   @default("SANDBOX_DEMO")
  paypalEmail String?  // the collective's PayPal Business account (display only)
  // Bank-style "new payee" control: the first payment to a recipient this
  // collective has never paid needs one extra approval.
  newPayeeRule Boolean @default(true)
  // Seeded showcase treasuries are listed for every visitor; user-created ones
  // only for the browser that created them.
  isDemo      Boolean  @default(false)
  // Stable id of a showcase treasury (e.g. "LISBON"), so renaming it never
  // makes startup seed a second copy.
  demoKey     String?
  // A browser's private copy of a demo (the visitor cookie it belongs to).
  // Templates have none; copies keep visitors from affecting each other.
  demoOwner   String?
  // Who reviews spending: "FIXED" approvers, a "RANDOM" hidden panel drawn
  // from all members, or "MIXED" (one seat from the approvers, the rest random).
  approvalMode String  @default("FIXED")
  // Shareable invite link (/join/<code>). The admin can reset it, which stops
  // the old link working, or turn it off (null).
  inviteCode  String?  // random 96-bit code; indexed below
  // What happens to money when someone leaves or the group closes:
  // "NO_REFUNDS" (gifts to the cause), "UNSPENT_SHARE" (your share of what's
  // left, by contribution) or "VOTE" (the group decides each case).
  exitPolicy  String   @default("VOTE")
  // Most active members the group allows. Changed only by a rule change.
  maxMembers  Int      @default(50)
  // Which PayPal sandbox business account this group uses: a short key whose
  // credentials live in env (PAYPAL_CLIENT_ID_<KEY> …). Null = the shared one.
  paypalAccount      String?
  // The outside-activity check flags PayPal transactions after this moment
  // that CoTreasury didn't make (earlier history is the account's past).
  paypalMonitorSince DateTime?
  lastReconciledAt   DateTime?
  // "OPEN" → "CLOSING" (final settlement being paid) → "CLOSED" (read-only).
  status      String   @default("OPEN")
  closedAt    DateTime?
  createdAt   DateTime @default(now())

  members     Member[]
  tiers       GovernanceTier[]
  entries     LedgerEntry[]
  proposals   Proposal[]
  goals       Goal[]
  events      AuditEvent[]

  @@index([inviteCode])
  @@index([demoOwner])
}

model Member {
  id           String   @id @default(cuid())
  collectiveId String
  name         String
  email        String
  role         String   @default("MEMBER") // "MEMBER" | "APPROVER" | "ADMIN" | "DISPUTING" (refund dispute with PayPal: listed, cannot vote) | "FORMER"
  // Notifications: the activity-log sequence number this member has seen up to.
  lastSeenSeq  Int      @default(0)
  // Asked to leave with a refund: still a member until the refund is paid; back to normal if it's rejected.
  leaving     Boolean  @default(false)
  createdAt    DateTime @default(now())

  collective   Collective @relation(fields: [collectiveId], references: [id], onDelete: Cascade)
  entries      LedgerEntry[]
  approvals    Approval[]
  proposals    Proposal[] @relation("ProposedBy")
  reviewSeats  ProposalReviewer[]

  @@unique([collectiveId, email])
}

// Spend thresholds: an amount in [minCents, maxCents) needs `requiredApprovals`
// approvals from members with the APPROVER or ADMIN role. maxCents null = no cap.
model GovernanceTier {
  id                String  @id @default(cuid())
  collectiveId      String
  minCents          Int
  maxCents          Int?
  requiredApprovals Int

  collective        Collective @relation(fields: [collectiveId], references: [id], onDelete: Cascade)
}

model LedgerEntry {
  id           String    @id @default(cuid())
  collectiveId String
  type         String    // "CONTRIBUTION" | "PAYOUT" | "REFUND" | "OPENING_BALANCE" | "UNAPPROVED_MOVEMENT"
  direction    String    // "IN" | "OUT"
  amountCents  Int
  status       String    @default("PENDING") // "PENDING" | "CONFIRMED" | "FAILED"
  // Where the status came from: "PAYPAL_WEBHOOK" | "PAYPAL_API" | "IMPORTED"
  source       String
  memo         String?
  counterparty String?   // payer or recipient display name / email
  memberId     String?
  proposalId   String?
  payoutRecipientId String? // PAYOUT rows: which recipient of the proposal this pays
  goalId       String?   // CONTRIBUTION rows: which goal the money is for
  paypalRef    String?   // capture id / payout item id / transaction id
  paypalTxnId  String?   // PayPal transaction id (as in PayPal's own history), for reconciliation
  createdAt    DateTime  @default(now())
  confirmedAt  DateTime?

  collective   Collective @relation(fields: [collectiveId], references: [id], onDelete: Cascade)
  member       Member?    @relation(fields: [memberId], references: [id], onDelete: SetNull)
  proposal     Proposal?  @relation(fields: [proposalId], references: [id], onDelete: SetNull)

  @@index([collectiveId, createdAt])
}

model Proposal {
  id                String   @id @default(cuid())
  collectiveId      String
  kind              String   @default("SPEND") // "SPEND" | "RULE_CHANGE" | "REFUND" (to a departing member) | "CLOSE" (final settlement) | "HOLD" (money set aside during a refund dispute; APPROVED while held)
  title             String
  description       String?
  amountCents       Int
  // Snapshot of the tier at proposal time, so later rule edits can't change
  // what an in-flight proposal needs.
  requiredApprovals Int
  status            String   @default("PENDING_APPROVAL") // "PENDING_APPROVAL" | "APPROVED" | "EXECUTING" | "COMPLETED" | "REJECTED" | "FAILED"
  proposedById      String?
  aiAssessment      String?  // JSON from the AI Treasurer (advisory only)
  flags             String?  // JSON [{code, message, extraApproval}] from deterministic risk checks
  changePayload     String?  // RULE_CHANGE only: JSON of the proposed rules, applied on approval
  paypalBatchId     String?
  payoutAttempts    Int      @default(0)
  executedAt        DateTime? // when the PayPal payout batch was sent
  failureReason     String?
  // Random review panel: the secret seed is revealed after the decision; its
  // hash is sealed in the activity log when the panel is drawn.
  panelSeed         String?
  panelCommitment   String?
  // Set when the request can no longer reach its approvals. No money moves,
  // but voting stays open so everyone eligible is heard; it closes as
  // REJECTED once they have all voted or the review window passes.
  wontPassAt        DateTime?
  createdAt         DateTime @default(now())

  collective        Collective @relation(fields: [collectiveId], references: [id], onDelete: Cascade)
  proposedBy        Member?    @relation("ProposedBy", fields: [proposedById], references: [id], onDelete: SetNull)
  recipients        PayoutRecipient[]
  approvals         Approval[]
  entries           LedgerEntry[]
  reviewers         ProposalReviewer[]
}

model PayoutRecipient {
  id           String  @id @default(cuid())
  proposalId   String
  name         String
  receiver     String  // email / phone / Venmo handle
  receiverType String  @default("EMAIL") // "EMAIL" | "PHONE" (see lib/recipients.ts)
  amountCents  Int
  // PENDING → SENT (in a batch) → SUCCEEDED | UNCLAIMED | FAILED | RETURNED
  status       String  @default("PENDING")
  paypalItemId String?

  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
}

model Approval {
  id         String   @id @default(cuid())
  proposalId String
  memberId   String
  decision   String   // "APPROVE" | "REJECT"
  createdAt  DateTime @default(now())

  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([proposalId, memberId])
}

// Every PayPal webhook we receive, stored once by PayPal's event id so retries
// are idempotent.
model WebhookEvent {
  id          String    @id // PayPal event id
  eventType   String
  verified    Boolean
  payload     String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

// What the collective is saving for. TARGET: a one-off amount per member by a
// due date. MONTHLY: a recurring pledge per member.
model Goal {
  id                  String    @id @default(cuid())
  collectiveId        String
  title               String
  kind                String    // "TARGET" | "MONTHLY"
  perMemberCents      Int
  dueDate             DateTime? // TARGET only
  startMonth          DateTime? // MONTHLY only: first month of the pledge
  createdAt           DateTime  @default(now())

  collective          Collective @relation(fields: [collectiveId], references: [id], onDelete: Cascade)
}

// Tamper-evident activity log: each event's hash covers its own content and
// the previous event's hash, so editing or deleting history breaks the chain.
model AuditEvent {
  id           String   @id @default(cuid())
  collectiveId String
  seq          Int
  actor        String   // display name, "PayPal" or "AI Treasurer"
  action       String   // e.g. "CONTRIBUTION_CONFIRMED", "VOTE_APPROVE"
  summary      String
  data         String   // canonical JSON
  createdAt    DateTime @default(now())
  prevHash     String
  hash         String

  collective   Collective @relation(fields: [collectiveId], references: [id], onDelete: Cascade)

  @@unique([collectiveId, seq])
}

// A seat on a request's random review panel. Hidden from everyone but the
// reviewer until the request is decided.
model ProposalReviewer {
  id         String   @id @default(cuid())
  proposalId String
  memberId   String
  seat       String   // "OFFICER" (drawn from approvers) | "MEMBER" (drawn from everyone else)
  status     String   @default("ACTIVE") // "ACTIVE" | "VOTED" | "REPLACED"
  assignedAt DateTime @default(now())
  expiresAt  DateTime

  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([proposalId, memberId])
}
